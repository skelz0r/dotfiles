#!/usr/bin/env bash
#
# dotfiles-test - Run the lint, smoke and behaviour tests of the dotfiles
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

REPO_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS] [SUITE...]

Run the test suites of the dotfiles repository. Without a suite, run
them all.

Suites:
  lint      shell conventions and shellcheck (test/lint.sh)
  smoke     bin --help, zsh and vim startup, statusline, install dry run
  tests     behaviour tests: install.sh, migration, upload-assets prepare,
            gh-media-log, tidy-commits, agentic-review, block-secrets,
            git-hooks, herdr-dispatch, cve-watch

Options:
  -v, --verbose   Show the output of every bats test, not only failures
  -h, --help      Show this help message

Requires bats-core and shellcheck (brew bundle) and python3.
EOF
  exit 0
}

log() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
section() { echo -e "\n${BLUE}==> $*${NC}"; }

VERBOSE=false
SUITES=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -v|--verbose) VERBOSE=true; shift ;;
    -h|--help) usage ;;
    lint|smoke|tests) SUITES+=("$1"); shift ;;
    *) error "Unknown suite or option: $1 (use --help)"; exit 1 ;;
  esac
done

[[ "${#SUITES[@]}" -gt 0 ]] || SUITES=(lint smoke tests)

cd "$REPO_ROOT"

require() {
  local cmd="$1" hint="$2"
  if ! command -v "$cmd" > /dev/null; then
    error "$cmd is missing ($hint)"
    exit 1
  fi
}

require bats "brew install bats-core"
require python3 "brew install python"

bats_args=()
$VERBOSE && bats_args+=(--verbose-run)

FAILED=()

run_bats() {
  local label="$1"
  shift
  section "$label"
  if bats ${bats_args[@]+"${bats_args[@]}"} "$@"; then
    success "$label"
  else
    FAILED+=("$label")
  fi
}

run_python_tests() {
  section "tidy-commits (python)"
  local runner
  if python3 -c "import pytest" 2> /dev/null; then
    runner=(python3 -m pytest -q test)
  else
    runner=(python3 -m unittest discover -s test -p "*_test.py")
  fi
  if "${runner[@]}"; then
    success "tidy-commits"
  else
    FAILED+=("tidy-commits")
  fi
}

for suite in "${SUITES[@]}"; do
  case $suite in
    lint)
      section "lint"
      if test/lint.sh; then
        success "lint"
      else
        FAILED+=("lint")
      fi
      ;;
    smoke)
      run_bats "smoke" test/smoke
      ;;
    tests)
      run_bats "behaviour (bats)" test/*.bats
      run_python_tests
      ;;
  esac
done

echo ""
if [[ "${#FAILED[@]}" -gt 0 ]]; then
  error "Failed: ${FAILED[*]}"
  exit 1
fi
success "All suites passed: ${SUITES[*]}"
