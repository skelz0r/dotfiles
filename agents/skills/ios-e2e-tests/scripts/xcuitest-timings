#!/usr/bin/env python3
"""Per-test durations and setup cost from xcodebuild UI test logs.

usage: xcuitest-timings [--marker REGEX] [--top N] LOG [LOG...]

Reads the plain xcodebuild output of UI test runs (one log per worker or
shard) and prints, slowest first, each test's duration and the time at
which its first line matching --marker appeared in the XCTest activity
timeline ("t = 7.85s Type '111111' into ..."). With a marker set on the
last step of the sign-in, that time is the fixed cost each test pays
before checking anything.

Ends with the totals: tests, simulator seconds, seconds per worker log
(shard balance), and the share of simulator time spent before the marker.
"""

import argparse
import re
import sys
from collections import defaultdict

STARTED = re.compile(r"Test Case '-\[(\S+) (\w+)\]' started")
FINISHED = re.compile(r"Test Case '-\[(\S+) (\w+)\]' (passed|failed) \((\d+\.\d+) seconds\)")
ACTIVITY = re.compile(r"^\s+t =\s+(\d+\.\d+)s (.*)")


def parse(paths, marker):
    results = []
    per_log = defaultdict(float)
    for path in paths:
        current = None
        marker_time = None
        with open(path, errors="replace") as log:
            for line in log:
                started = STARTED.search(line)
                if started:
                    current = f"{started.group(1).split('.')[-1]}/{started.group(2)}"
                    marker_time = None
                    continue
                activity = ACTIVITY.match(line)
                if activity and current and marker and marker_time is None and marker.search(activity.group(2)):
                    marker_time = float(activity.group(1))
                    continue
                finished = FINISHED.search(line)
                if finished and current:
                    duration = float(finished.group(4))
                    results.append((duration, marker_time, finished.group(3), current, path))
                    per_log[path] += duration
                    current = None
    return results, per_log


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("logs", nargs="+", metavar="LOG")
    parser.add_argument("--marker", help="regex of the activity line ending the setup, e.g. \"Type '111111'\"")
    parser.add_argument("--top", type=int, default=0, help="only print the N slowest tests")
    args = parser.parse_args()

    marker = re.compile(args.marker) if args.marker else None
    results, per_log = parse(args.logs, marker)
    if not results:
        sys.exit("no 'Test Case ... passed|failed (n seconds)' line found: pass the raw xcodebuild output")

    results.sort(reverse=True)
    shown = results[: args.top] if args.top else results
    for duration, marker_time, status, name, _ in shown:
        setup = f"{marker_time:6.1f}" if marker_time is not None else "     -"
        flag = "" if status == "passed" else "  FAILED"
        print(f"{duration:7.1f} {setup}  {name}{flag}")

    total = sum(r[0] for r in results)
    print(f"\n{len(results)} tests, {total:.0f} s of simulator time, {total / len(results):.1f} s per test")
    for path, seconds in sorted(per_log.items()):
        print(f"  {seconds:7.0f} s  {path}")
    if marker:
        marked = [r for r in results if r[1] is not None]
        if marked:
            setup_total = sum(r[1] for r in marked)
            print(
                f"{len(marked)} tests reach the marker after {setup_total / len(marked):.1f} s on average: "
                f"{setup_total / total:.0%} of simulator time"
            )


if __name__ == "__main__":
    main()
