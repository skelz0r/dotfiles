#!/usr/bin/env bash
#
# dotfiles-test - Run the lint, smoke and behaviour tests of the dotfiles
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

INSTALLED_ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

dotfiles_checkout_of_cwd() {
  local top
  top="$(git rev-parse --show-toplevel 2> /dev/null)" || return 1
  [[ -f "$top/bin/dotfiles-test" && -f "$top/test/lint.sh" ]] || return 1
  echo "$top"
}

REPO_ROOT="$(dotfiles_checkout_of_cwd || echo "$INSTALLED_ROOT")"

usage() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS] [SUITE...]

Run the test suites of the dotfiles repository. Without a suite, run
them all. Tests the dotfiles checkout (or worktree) of the current
directory, else the one this script belongs to.

Suites:
  lint      shell conventions and shellcheck (test/lint.sh)
  smoke     bin --help, zsh and vim startup, statusline, install dry run
  tests     behaviour tests: install.sh, migration, upload-assets prepare,
            gh-media-log, tidy-commits, agentic-review, block-secrets,
            block-hook-bypass, git-hooks, herdr-dispatch, cve-watch,
            ci-slot, rubocop-ratchet and the opt-in of the global
            RuboCop cops; specs of the cops (rspec)

Options:
  -v, --verbose   Show the output of every bats test, not only failures
  -j, --jobs N    Run N bats tests at once (default: CPU count, or
                  DOTFILES_TEST_JOBS; 1 without GNU parallel)
  -h, --help      Show this help message

Requires bats-core and shellcheck (brew bundle), python3, and the
rubocop and rspec gems. GNU parallel (brew bundle) runs the bats tests
concurrently: most of their time is spent waiting.
EOF
  exit 0
}

log() { echo -e "${BLUE}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
section() { echo -e "\n${BLUE}==> $*${NC}"; }

VERBOSE=false
JOBS="${DOTFILES_TEST_JOBS:-}"
SUITES=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -v|--verbose) VERBOSE=true; shift ;;
    -j|--jobs)
      [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { error "--jobs needs a positive number"; exit 1; }
      JOBS="$2"; shift 2 ;;
    -h|--help) usage ;;
    lint|smoke|tests) SUITES+=("$1"); shift ;;
    *) error "Unknown suite or option: $1 (use --help)"; exit 1 ;;
  esac
done

[[ "${#SUITES[@]}" -gt 0 ]] || SUITES=(lint smoke tests)

cd "$REPO_ROOT"
log "Testing $REPO_ROOT"

require() {
  local cmd="$1" hint="$2"
  if ! command -v "$cmd" > /dev/null; then
    error "$cmd is missing ($hint)"
    exit 1
  fi
}

require bats "brew install bats-core"
require python3 "brew install python"

bats_args=()
$VERBOSE && bats_args+=(--verbose-run)

cpu_count() {
  getconf _NPROCESSORS_ONLN 2> /dev/null || sysctl -n hw.ncpu 2> /dev/null || echo 1
}

if command -v parallel > /dev/null; then
  JOBS="${JOBS:-$(cpu_count)}"
elif [[ "${JOBS:-1}" -gt 1 ]]; then
  warn "GNU parallel is missing (brew install parallel): bats runs serially"
  JOBS=1
fi
if [[ "${JOBS:-1}" -gt 1 ]]; then
  bats_args+=(--jobs "$JOBS")
fi

FAILED=()

run_bats() {
  local label="$1"
  shift
  section "$label"
  if bats ${bats_args[@]+"${bats_args[@]}"} "$@"; then
    success "$label"
  else
    FAILED+=("$label")
  fi
}

run_python_tests() {
  section "tidy-commits (python)"
  local runner
  if python3 -c "import pytest" 2> /dev/null; then
    runner=(python3 -m pytest -q test)
  else
    runner=(python3 -m unittest discover -s test -p "*_test.py")
  fi
  if "${runner[@]}"; then
    success "tidy-commits"
  else
    FAILED+=("tidy-commits")
  fi
}

run_rubocop_cop_specs() {
  section "rubocop cops (rspec)"
  require rspec "gem install rspec rubocop"
  if rspec test/rubocop; then
    success "rubocop cops"
  else
    FAILED+=("rubocop cops")
  fi
}

for suite in "${SUITES[@]}"; do
  case $suite in
    lint)
      section "lint"
      if test/lint.sh; then
        success "lint"
      else
        FAILED+=("lint")
      fi
      ;;
    smoke)
      run_bats "smoke" test/smoke
      ;;
    tests)
      run_bats "behaviour (bats)" test/*.bats
      run_python_tests
      run_rubocop_cop_specs
      ;;
  esac
done

echo ""
if [[ "${#FAILED[@]}" -gt 0 ]]; then
  error "Failed: ${FAILED[*]}"
  exit 1
fi
success "All suites passed: ${SUITES[*]}"
